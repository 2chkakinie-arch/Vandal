{
  "name": "vandal",
  "version": "1.0.0",
  "description": "Vandal — ultra-fast, self-contained YouTube frontend. InnerTube direct-play engine + instance cooperation mesh (shared proxy pool) + Ask AI. An independent open project.",
  "main": "index.js",
  "type": "commonjs",
  "author": "Vandal Project",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node index.js",
    "start:edge": "node scripts/launch.mjs",
    "dev": "node index.js",
    "build:edge": "cd goedge && go build -trimpath -ldflags \"-s -w\" -o bin/vandal-edge .",
    "test:api": "node scripts/smoke.js",
    "test:edge": "node scripts/smoke-edge.js",
    "test:core": "node scripts/smoke-core.js",
    "test:all": "node scripts/smoke.js && node scripts/smoke-core.js && node scripts/smoke-edge.js",
    "test:fault": "node scripts/fault-inject.js",
    "test:issue": "node scripts/test-issue-direct.js"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "express": "^4.21.2",
    "hls.js": "^1.7.0",
    "undici": "^6.21.1",
    "ws": "^8.21.3",
    "youtube-search-api": "^2.0.1"
  }
}
