/* =====================================================================
   設定ページ（一般）& ドキュメントページ
   ===================================================================== */
.set-page { max-width: 760px; margin: 0 auto; padding: 20px 16px 80px; display: flex; flex-direction: column; gap: 18px; }
.set-head { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; padding: 8px 4px 0; }
.set-head .brand-wordmark { flex: none; }
.set-head h1 { font-size: 26px; font-weight: 800; letter-spacing: -.3px; }
.set-sub { color: var(--text-2); font-size: 13px; margin-top: 2px; }
.set-ic { font-size: 19px; }

/* ---- 管理者バッジ / 管理ロック（訪問者は読み取り専用） ---- */
.adm-pill {
  margin-left: auto; font-size: 11.5px; font-weight: 800; letter-spacing: .4px;
  color: #071018; border-radius: 999px; padding: 5px 12px;
  background: linear-gradient(90deg, #5b8dff, #2fd9ff);
}
.adm-area { margin-top: 16px; }
.adm-lock {
  display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
  border: 1px dashed var(--border); border-radius: 16px; padding: 14px 16px;
  background: var(--chip-bg);
}
.adm-lock-ic { width: 26px; height: 26px; fill: var(--text-3); flex: none; }
.adm-lock-t { font-size: 13.5px; font-weight: 700; }
.adm-lock-s { font-size: 12px; color: var(--text-3); margin-top: 4px; line-height: 1.65; max-width: 480px; }
.adm-lock-form { margin-left: auto; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
.adm-lock-form input {
  height: 40px; border-radius: 12px; border: 1.5px solid var(--border); background: var(--bg-elev);
  color: var(--text); padding: 0 14px; font-size: 13px; width: 200px; outline: none;
  transition: border-color var(--dur);
}
.adm-lock-form input:focus { border-color: var(--focus); }
@media (max-width: 640px) { .adm-lock-form { margin-left: 0; } .adm-lock-form input { width: 100%; } }

.set-card {
  background: var(--bg-elev); border: 1px solid var(--border); border-radius: 20px;
  padding: 18px 20px; box-shadow: var(--shadow);
}
.set-card h2 { font-size: 16.5px; font-weight: 700; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

.set-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin-top: 16px; }
.set-btn {
  height: 40px; padding: 0 20px; border-radius: 999px; font-size: 13px; font-weight: 600;
  background: var(--chip-bg); color: var(--text); transition: all var(--dur);
  border: 1px solid transparent; display: inline-flex; align-items: center; gap: 8px; text-decoration: none;
}
.set-btn:hover { background: var(--hover-2); }
.set-btn.primary { background: var(--accent-grad); color: #fff; box-shadow: 0 4px 14px rgba(91, 141, 255, .3); }
.set-btn.primary:hover { filter: brightness(1.06); }
.set-btn.warn { background: rgba(245, 158, 11, .16); color: #d97706; }
.set-btn.warn:hover { background: rgba(245, 158, 11, .26); }
.set-note { font-size: 12px; color: var(--text-3); margin-top: 12px; line-height: 1.7; }

.seg { display: flex; background: var(--chip-bg); border-radius: 14px; padding: 4px; gap: 4px; margin-top: 0; }
.seg button {
  flex: 1; border-radius: 10px; padding: 9px 6px; font-size: 13px; font-weight: 600; color: var(--text-2);
  transition: all var(--dur); display: flex; flex-direction: column; gap: 2px; align-items: center; cursor: pointer;
}
.seg button:hover { background: var(--hover); }
.seg button.sel { background: var(--bg-elev); color: var(--accent); box-shadow: 0 2px 8px rgba(8,10,24,.14); }
.seg-sm button { flex-direction: row; padding: 8px 14px; }

.set-about { color: var(--text-2); font-size: 13px; line-height: 1.8; margin-top: 4px; }

/* =====================================================================
   ドキュメントページ
   ===================================================================== */
.doc-page { max-width: 960px; margin: 0 auto; padding: 28px 16px 80px; }
.doc-hero { display: flex; flex-direction: column; align-items: center; gap: 10px; padding: 24px 16px 20px; text-align: center; }
.doc-hero .brand-wordmark { --word-size: 42px; }
.doc-tag { color: var(--text-2); font-size: 15px; letter-spacing: .2px; }
.doc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; }
.doc-card {
  background: var(--bg-elev); border: 1px solid var(--border); border-radius: 20px;
  padding: 20px 22px; box-shadow: var(--shadow);
}
.doc-card h2 { font-size: 16px; font-weight: 800; margin-bottom: 12px; letter-spacing: -.2px; }
.doc-card p { font-size: 13.5px; color: var(--text-2); line-height: 1.85; margin-bottom: 10px; }
.doc-card p:last-child { margin-bottom: 0; }
.doc-code {
  background: #0b0d12; color: #cdd3e0; border-radius: 12px; padding: 14px 16px;
  font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 12px;
  line-height: 1.7; overflow-x: auto; margin: 6px 0 10px; white-space: pre;
}
.doc-note { font-size: 12px !important; color: var(--text-3) !important; }
.doc-license { border-color: rgba(91, 141, 255, .4); background: linear-gradient(180deg, rgba(91, 141, 255, .06), transparent 60%), var(--bg-elev); grid-column: span 2; }
.doc-license strong { color: var(--text); font-weight: 700; }
@media (max-width: 760px) {
  .doc-grid { grid-template-columns: 1fr; }
  .doc-license { grid-column: span 1; }
}
