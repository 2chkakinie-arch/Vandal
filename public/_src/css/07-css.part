/* ================================================================= INSTANCES
 * インスタンスリスト — シンプル・モダンな再デザイン。
 * 虹グラデ・装飾を排し、余白・階層・モノトーン + ワンアクセントで情報を際立たせる。
 * Vandal Project — independent open project.
 */
.inst-page { padding: 26px 4px 80px; max-width: 1040px; margin: 0 auto; }

/* ---- hero（ロゴ + 一言） ---- */
.inst-hero {
  display: flex; align-items: center; gap: 16px; padding: 6px 6px 22px;
}
.inst-hero .brand-wordmark { --word-size: 30px; flex: none; }
.inst-hero-txt h1 { font-size: 24px; font-weight: 800; letter-spacing: -.4px; }
.inst-hero-txt p { font-size: 13px; color: var(--text-2); margin-top: 3px; line-height: 1.6; max-width: 640px; }
.inst-skeleton { padding: 48px 0; display: grid; place-items: center; }

/* ---- self strip（このインスタンスの今） ---- */
.inst-self-strip {
  display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;
  border: 1px solid var(--border); border-radius: 18px; padding: 18px 20px; margin: 4px 0 24px;
  background: var(--bg-elev);
  box-shadow: var(--shadow);
  position: relative; overflow: hidden;
}
.inst-self-strip::before {           /* 左端に細いアクセントバー（控えめ） */
  content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 3px;
  border-radius: 0 3px 3px 0; background: linear-gradient(180deg, #5b8dff, #2fd9ff);
}
.iss-left { display: flex; align-items: center; gap: 14px; min-width: 0; }
.iss-name { font-weight: 700; font-size: 14.5px; display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.iss-sub { font-size: 12px; color: var(--text-3); margin-top: 4px; }
.iss-right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.mode-pill {
  font-size: 12px; font-weight: 700; border-radius: 999px; padding: 5px 12px;
  display: inline-flex; align-items: center; gap: 6px;
}
.mode-pill.pub { background: rgba(46, 170, 110, .13); color: #1a7f37; }
.mode-pill.priv { background: rgba(255, 190, 60, .14); color: #b45309; }
html.dark .mode-pill.pub { color: #7ce38b; }
html.dark .mode-pill.priv { color: #ffd166; }

/* ---- tier table ---- */
.tier-table { display: flex; flex-direction: column; gap: 12px; }
.tier-row {
  display: grid; grid-template-columns: 150px 1fr; gap: 0; align-items: stretch;
  border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: var(--bg-elev);
}
.tier-cell {
  display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px;
  padding: 18px 12px; background: var(--chip-bg); border-right: 1px solid var(--border);
  position: relative;
}
.tier-count {
  position: absolute; top: 10px; right: 10px; font-size: 10.5px; font-weight: 800;
  color: var(--text-3); background: var(--bg-elev); border: 1px solid var(--border);
  min-width: 20px; height: 20px; border-radius: 999px; display: grid; place-items: center; padding: 0 5px;
}
.tier-desc { font-size: 11px; color: var(--text-3); text-align: center; line-height: 1.55; max-width: 120px; }
.tier-cards { display: flex; flex-direction: column; gap: 8px; padding: 10px; }

.tier-badge {
  display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 10px;
  font-weight: 900; font-size: 15px; color: #071018; flex: none;
}
.tier-badge.big { width: 42px; height: 42px; font-size: 21px; border-radius: 13px; }
.t-s { background: linear-gradient(135deg, #8af0a4, #33c96c); }
.t-a { background: linear-gradient(135deg, #8fd8ff, #3aa9f5); }
.t-b { background: linear-gradient(135deg, #ffdd8a, #f5b428); }
.t-c { background: linear-gradient(135deg, #ffb3ab, #ff8579); }

/* ---- instance card ---- */
.inst-card {
  border: 1px solid var(--border); border-radius: 14px; padding: 13px 15px;
  background: var(--bg); transition: border-color .16s, box-shadow .16s;
}
.inst-card:hover { border-color: rgba(91, 141, 255, .45); box-shadow: 0 2px 12px rgba(91, 141, 255, .10); }
.inst-card.self { border-color: rgba(91, 141, 255, .6); box-shadow: 0 0 0 1px rgba(91, 141, 255, .22); }
.inst-card-top { display: flex; align-items: center; gap: 10px; }
.inst-name { font-weight: 600; font-size: 13.5px; display: flex; align-items: center; gap: 8px; min-width: 0; overflow-wrap: anywhere; }
.inst-self-tag {
  font-size: 10.5px; font-weight: 800; color: #fff; border-radius: 999px; padding: 2px 9px; flex: none;
  background: linear-gradient(90deg, #5b8dff, #2fd9ff); color: #071018;
}
.inst-self-tag.anon { background: var(--chip-bg); color: var(--text-2); border: 1px solid var(--border); }
.inst-score { margin-left: auto; display: flex; align-items: center; gap: 7px; flex: none; }
.inst-bar { width: 84px; height: 6px; border-radius: 4px; background: var(--chip-bg); overflow: hidden; display: inline-block; }
.inst-bar i { display: block; height: 100%; border-radius: 4px; background: linear-gradient(90deg, #5b8dff, #2fd9ff); }
.inst-bar-num { font-size: 12px; font-weight: 700; color: var(--text-2); width: 26px; text-align: right; font-variant-numeric: tabular-nums; }
.inst-url { font-size: 11.5px; color: var(--text-3); margin: 7px 0 0 40px; overflow-wrap: anywhere; }
.inst-chips { display: flex; flex-wrap: wrap; gap: 6px; margin: 9px 0 0 40px; }
.ichip {
  font-size: 11px; color: var(--text-3); background: var(--chip-bg);
  border-radius: 999px; padding: 3px 9px; display: inline-flex; gap: 4px; align-items: center;
}
.ichip b { color: var(--text); font-weight: 700; }
.ichip em { font-style: normal; color: #2fbf5f; font-weight: 700; font-size: 10px; }
.ichip.ok { color: #1a7f37; font-weight: 700; }
html.dark .ichip.ok { color: #7ce38b; }
.ichip.warn { color: #b45309; font-weight: 700; }
html.dark .ichip.warn { color: #ffd166; }

.inst-empty { padding: 30px; color: var(--text-3); font-size: 13px; text-align: center; line-height: 1.8; border: 1px dashed var(--border); border-radius: 18px; }
.inst-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 24px; }
.inst-roles { list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 12.5px; color: var(--text-2); line-height: 1.75; }
.inst-roles b { color: var(--text); }
.inst-roles li { padding-left: 16px; position: relative; }
.inst-roles li::before { content: ''; position: absolute; left: 0; top: .62em; width: 7px; height: 7px; border-radius: 2px; background: linear-gradient(135deg, #5b8dff, #2fd9ff); }

@media (max-width: 900px) {
  .tier-row { grid-template-columns: 1fr; }
  .tier-cell { flex-direction: row; border-right: 0; border-bottom: 1px solid var(--border); gap: 12px; padding: 10px 14px; }
  .tier-desc { text-align: left; max-width: none; }
  .tier-cards { padding: 8px; }
  .inst-grid { grid-template-columns: 1fr; }
  .inst-url, .inst-chips { margin-left: 0; }
  .inst-score { display: none; }
  .inst-hero { flex-direction: column; align-items: flex-start; gap: 12px; }
}

/* =====================================================================
   VANDAL — プレミアムブランド UI レイヤー（最終上書き）
   高級感・ブランド感: Inter/Noto タイポグラフィ、ブランドグロー、
   ガラス質感マストヘッド、上質な設定カードと多言語・テーマ・音声UI。
   ===================================================================== */

/* ---- タイポグラフィ（多言語で美しくなるスタック） ---- */
body {
  font-family: "Inter", "Noto Sans JP", "Noto Sans SC", "Noto Sans", "Hiragino Kaku Gothic ProN", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  text-rendering: optimizeLegibility;
  font-feature-settings: "kern" 1, "liga" 1;
  letter-spacing: .01em;
}
input, button, textarea, select { font-family: inherit; }
:root { --font-ui: "Inter", "Noto Sans JP", "Noto Sans SC", "Noto Sans", system-ui, sans-serif; }

/* ---- 全体のアンビエントグロー（ブランドの空気感） ---- */
#content::before {
  content: "";
  position: fixed; inset: 0 0 auto 0; height: 420px; pointer-events: none; z-index: -1;
  background:
    radial-gradient(560px 220px at 18% -8%, rgba(91, 141, 255, .14), transparent 62%),
    radial-gradient(520px 220px at 84% -10%, rgba(47, 217, 255, .10), transparent 60%);
}
html.dark #content::before { opacity: .9; }

/* ---- マストヘッド（ガラス + ブランドヘアライン） ---- */
#masthead {
  background: color-mix(in srgb, var(--bg-glass) 92%, transparent);
  box-shadow: 0 1px 0 rgba(91, 141, 255, .12), 0 8px 30px rgba(10, 14, 30, .06);
}
#masthead::after {
  content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 1px; pointer-events: none;
  background: linear-gradient(90deg, transparent, rgba(91, 141, 255, .55) 22%, rgba(47, 217, 255, .5) 55%, rgba(115, 130, 255, .45) 78%, transparent);
  opacity: .5;
}
html.dark #masthead { box-shadow: 0 1px 0 rgba(91, 141, 255, .2), 0 10px 34px rgba(0, 0, 0, .5); }

/* ---- ロゴ（logo.png ブランドワードマーク） ---- */
.logo-img, .brand-wordmark-img {
  -webkit-mask-image: linear-gradient(180deg, #000 82%, rgba(0,0,0,.9));
          mask-image: linear-gradient(180deg, #000 82%, rgba(0,0,0,.9));
}
.logo { position: relative; }
.logo:hover { background: linear-gradient(180deg, transparent, var(--hover)); }

/* ---- 検索 / マイク（音声入力） ---- */
#search-input, .search-btn { border-radius: 999px; }
#search-form .mic {
  background: var(--chip-bg);
  transition: background var(--dur), color var(--dur), box-shadow var(--dur), transform var(--dur);
}
#search-form .mic:hover { background: var(--hover-2); }
#search-form .mic.listening,
.ask-mic.listening {
  background: linear-gradient(120deg, #ff3d81, #ff8a00) !important;
  color: #fff !important;
  box-shadow: 0 0 0 6px rgba(255, 61, 129, .16), 0 6px 18px rgba(255, 61, 129, .35);
  animation: micPulse 1.15s ease-in-out infinite;
}
@keyframes micPulse {
  0%, 100% { box-shadow: 0 0 0 4px rgba(255, 61, 129, .14), 0 6px 18px rgba(255, 61, 129, .32); }
  50% { box-shadow: 0 0 0 10px rgba(255, 61, 129, .07), 0 8px 26px rgba(255, 61, 129, .42); }
}
@media (max-width: 760px) {
  #search-form .mic { display: grid; width: 36px; height: 36px; }
}

/* ---- チップ / アクティブ（ブランドグラデーション活性） ---- */
.chip.active {
  background: var(--accent-grad) !important;
  color: var(--accent-ink) !important;
  box-shadow: 0 4px 14px rgba(91, 141, 255, .32);
}
.chip { border: 1px solid transparent; }
.chip:hover { border-color: rgba(91, 141, 255, .25); }

/* ---- カードホバー（上質な浮遊感） ---- */
.vcard:hover .vthumb, .scard:hover .sthumb {
  box-shadow: 0 14px 38px rgba(8, 10, 24, .18);
}
.sec-title, .section-title { letter-spacing: -.015em; }

/* ---- 設定ページ（プレミアムカード + グラデーションアイコン） ---- */
.set-page { max-width: 820px; }
.set-head { padding: 10px 4px 4px; }
.set-head h1 {
  font-size: 28px; font-weight: 900; letter-spacing: -.02em;
  background: linear-gradient(96deg, var(--text), rgba(91, 141, 255, .85));
  -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
}
.set-card {
  border: 1px solid var(--border);
  background: linear-gradient(180deg, rgba(255,255,255,.02), transparent), var(--bg-elev);
  transition: border-color var(--dur), box-shadow var(--dur), transform var(--dur);
}
.set-card:hover { border-color: rgba(91, 141, 255, .35); box-shadow: var(--shadow-lg); }
html.dark .set-card:hover { border-color: rgba(91, 141, 255, .4); }
.set-card-glow {
  position: relative;
}
.set-card-glow::after {
  content: ""; position: absolute; inset: -1px; border-radius: 21px; pointer-events: none;
  background: linear-gradient(120deg, rgba(91,141,255,.0), rgba(91,141,255,.12), rgba(47,217,255,.10), transparent);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor; mask-composite: exclude; padding: 1px; opacity: .9;
}
.set-ic {
  display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 11px;
  background: var(--chip-bg); font-size: 17px; box-shadow: inset 0 0 0 1px var(--border);
}

/* ---- テーマ / 言語セグメント ---- */
.seg { background: var(--bg); border: 1px solid var(--border); box-shadow: inset 0 1px 3px rgba(8,10,24,.04); }
.seg button { font-weight: 700; letter-spacing: .01em; }
.seg button.sel { background: var(--accent-grad); color: #fff; box-shadow: 0 4px 12px rgba(91,141,255,.35); }
.seg-lang { flex-wrap: wrap; max-width: 640px; }
.seg-lang button { flex: 0 0 auto; min-width: 96px; }

/* ---- ボタン ---- */
.set-btn { border: 1px solid var(--border); background: var(--bg-elev); }
.set-btn:hover { border-color: rgba(91, 141, 255, .4); box-shadow: 0 6px 18px rgba(91,141,255,.12); transform: translateY(-1px); }
.set-btn.primary { border-color: transparent; }
.set-btn.warn { border-color: rgba(245, 158, 11, .25); }

/* ---- Ask パネル（音声ボタン追加） ---- */
.ask-mic { width: 40px; height: 40px; border-radius: 50%; flex: none; color: var(--text-2); }
.ask-mic:hover { background: var(--hover); }

/* ---- ドキュメントヒーロー（ブランドグロー） ---- */
.doc-hero { position: relative; }
.doc-hero::before {
  content: ""; position: absolute; inset: -30px -40px auto; height: 200px; z-index: -1; border-radius: 50%;
  background: radial-gradient(closest-side, rgba(91,141,255,.12), transparent); filter: blur(6px);
}
.doc-tag { color: var(--text-2); font-weight: 500; }

/* ---- ショートプレイヤー（ブランドアクセント） ---- */
.shp-bar { background: var(--accent-grad); }
.shp-act.on { color: var(--accent); }
.shp-act.on .ic { fill: var(--accent); }

/* ---- 細部: スクロールバー / 選択 ---- */
::-webkit-scrollbar-thumb { background: rgba(91, 141, 255, .35); }
::selection { background: rgba(91, 141, 255, .28); }
