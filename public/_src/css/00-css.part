/* Vandal — YouTube-faithful UI. Vandal Project — independent open project. */
:root {
  --bg: #ffffff;
  --bg-elev: #ffffff;
  --text: #0f0f0f;
  --text-2: #606060;
  --text-3: #909090;
  --hover: rgba(0, 0, 0, .05);
  --hover-2: rgba(0, 0, 0, .1);
  --chip-bg: rgba(0, 0, 0, .05);
  --chip-active: #0f0f0f;
  --chip-active-text: #fff;
  --border: rgba(0, 0, 0, .1);
  --btn-black: #0f0f0f;
  --btn-black-text: #fff;
  --blue: #065fd4;
  --red: #ff0000;
  --accent: #ff0000;      /* YouTube red */
  --accent-ink: #ffffff;
  --shadow: 0 2px 12px rgba(0, 0, 0, .12);
  --focus: #1c62b9;
  --skeleton: #e5e5e5;
}
html.dark {
  --bg: #0f0f0f;
  --bg-elev: #212121;
  --text: #f1f1f1;
  --text-2: #aaa;
  --text-3: #717171;
  --hover: rgba(255, 255, 255, .1);
  --hover-2: rgba(255, 255, 255, .2);
  --chip-bg: rgba(255, 255, 255, .1);
  --chip-active: #f1f1f1;
  --chip-active-text: #0f0f0f;
  --border: rgba(255, 255, 255, .1);
  --btn-black: #f1f1f1;
  --btn-black-text: #0f0f0f;
  --shadow: 0 2px 12px rgba(0, 0, 0, .5);
  --skeleton: #272727;
}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { height: 100%; }
body {
  font-family: Roboto, "Hiragino Kaku Gothic ProN", "Noto Sans JP", Arial, sans-serif;
  background: var(--bg);
  color: var(--text);
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }
button { font-family: inherit; border: 0; background: none; cursor: pointer; color: inherit; }
input { font-family: inherit; }
.hidden { display: none !important; }
.ic { width: 24px; height: 24px; fill: currentColor; display: block; }

/* ============ masthead ============ */
#masthead {
  position: fixed; inset: 0 0 auto 0; height: 56px; z-index: 200;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 16px; background: var(--bg);
}
.mh-start { display: flex; align-items: center; min-width: 170px; }
.mh-center { flex: 1; display: flex; justify-content: center; padding: 0 16px; max-width: 720px; margin: 0 auto; }
.mh-end { display: flex; align-items: center; gap: 8px; min-width: 170px; justify-content: flex-end; position: relative; }
.icon-btn { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; flex: none; }
.icon-btn:hover { background: var(--hover); }
.icon-btn:active { background: var(--hover-2); }
.logo { display: flex; align-items: flex-start; padding: 8px 14px 8px 16px; margin-left: -8px; }
.logo-svg { width: 88px; height: 24px; color: var(--text); overflow: visible; }
.logo-mark { filter: drop-shadow(0 2px 8px rgba(255, 43, 214, .45)); }
.logo .country { font-size: 10px; color: var(--text-2); margin: 1px 0 0 2px; }

/* search */
.search { display: flex; align-items: center; width: 100%; max-width: 640px; gap: 12px; }
.search-box { position: relative; flex: 1; }
#search-input {
  width: 100%; height: 40px; padding: 0 16px; font-size: 16px;
  border: 1px solid var(--border); border-right: 0; background: var(--bg);
  border-radius: 40px 0 0 40px; color: var(--text); outline: none;
}
#search-input:focus { border-color: var(--focus); box-shadow: inset 0 1.5px 2px rgba(0,0,0,.06); }
.search-btn {
  width: 64px; height: 40px; flex: none; border: 1px solid var(--border);
  border-radius: 0 40px 40px 0; background: var(--chip-bg); display: grid; place-items: center;
}
.search-btn:hover { background: var(--hover-2); }
#search-form { display: flex; align-items: center; width: 100%; max-width: 640px; }
#search-form .mic { margin-left: 12px; background: var(--chip-bg); }
.suggest {
  position: absolute; top: 44px; left: 0; right: -64px; z-index: 300;
  background: var(--bg-elev); border-radius: 12px; box-shadow: var(--shadow);
  padding: 12px 0; overflow: hidden;
}
.suggest .sg { display: flex; align-items: center; gap: 14px; padding: 8px 20px; font-size: 15px; cursor: pointer; }
.suggest .sg:hover, .suggest .sg.active { background: var(--hover); }
.suggest .sg svg { width: 18px; height: 18px; fill: var(--text-2); flex: none; }

/* options menu */
.menu {
  position: absolute; top: 44px; right: 0; width: 260px; z-index: 400;
  background: var(--bg-elev); border-radius: 12px; box-shadow: var(--shadow);
  padding: 8px 0; font-size: 14px;
}
.menu-item { display: flex; align-items: center; gap: 14px; width: 100%; padding: 9px 16px; text-align: left; }
.menu-item:hover { background: var(--hover); }
.menu-item .ic { width: 22px; height: 22px; fill: var(--text); }

/* ============ layout ============ */
#page { display: flex; padding-top: 56px; min-height: 100vh; }
#mini-guide {
  width: 72px; flex: none; padding: 4px 0 12px; position: sticky; top: 56px;
  align-self: flex-start; height: calc(100vh - 56px); overflow-y: auto; overflow-x: hidden;
  scrollbar-width: thin; display: flex; flex-direction: column;
}
.guide-item {
  display: flex; flex-direction: column; align-items: center; gap: 5px;
  padding: 14px 0 12px; margin: 0 4px; border-radius: 10px; font-size: 10px; color: var(--text);
}
.guide-item:hover { background: var(--hover); }
.guide-item.active { font-weight: 500; }
.guide-foot { margin-top: auto; padding: 16px 8px 0; font-size: 10px; color: var(--text-3); display: none; }
.foot-links { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
.foot-links span:hover { cursor: pointer; }
.foot-credit { line-height: 1.5; color: var(--text-2); }
#mini-guide:hover .guide-foot { display: block; }
#content { flex: 1; min-width: 0; outline: none; }
#app { padding-bottom: 40px; }

/* ============ chips ============ */
.chips {
  position: sticky; top: 56px; z-index: 100; display: flex; gap: 12px;
  padding: 12px 24px; background: var(--bg); overflow-x: auto; scrollbar-width: none;
}
.chips::-webkit-scrollbar { display: none; }
.chip {
  flex: none; height: 32px; padding: 0 12px; border-radius: 8px; background: var(--chip-bg);
  font-size: 14px; display: flex; align-items: center; transition: background .15s;
}
.chip:hover { background: var(--hover-2); }
.chip.active { background: var(--chip-active); color: var(--chip-active-text); }

/* ============ video grid ============ */
.grid { display: grid; gap: 16px 16px; padding: 8px 24px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); row-gap: 40px; }
.vcard { display: flex; flex-direction: column; cursor: pointer; min-width: 0; }
/* 高速化: 画面外のカードはレイアウト/描画をスキップ（初回レンダリング大幅短縮） */
.vcard, .rcard, .result-card {
  content-visibility: auto;
  contain-intrinsic-size: auto 240px;
}
.result-card { contain-intrinsic-size: auto 200px; }
.vthumb { position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 16/9; background: var(--skeleton); }
.vthumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
.vthumb .dur {
  position: absolute; right: 4px; bottom: 4px; background: rgba(0,0,0,.8); color: #fff;
  font-size: 12px; font-weight: 500; padding: 1px 4px; border-radius: 4px; letter-spacing: .2px;
}
.vthumb .live-badge { background: var(--red); text-transform: uppercase; font-size: 11px; }
.vmeta { display: flex; gap: 12px; padding-top: 12px; }
.vava { width: 36px; height: 36px; border-radius: 50%; background: var(--skeleton); flex: none; overflow: hidden; }
.vava img { width: 100%; height: 100%; object-fit: cover; }
.vinfo { min-width: 0; flex: 1; }
.vtitle {
  font-size: 16px; font-weight: 500; line-height: 1.4; margin-bottom: 4px;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  word-break: break-word;
}
.vsub { font-size: 14px; color: var(--text-2); line-height: 1.45; }
.vsub .vch:hover { color: var(--text); }
.vcard .vtitle:hover { text-decoration: none; }

/* shorts row */
.shorts-row { padding: 12px 24px 24px; }
.shorts-title { display: flex; align-items: center; gap: 8px; font-size: 16px; font-weight: 600; margin: 0 0 12px; }
.shorts-title svg { width: 20px; height: 20px; fill: var(--red); }
.shorts-scroll { display: flex; gap: 12px; overflow-x: auto; scrollbar-width: none; padding-bottom: 4px; }
.shorts-scroll::-webkit-scrollbar { display: none; }
.scard { flex: none; width: 160px; cursor: pointer; }
.sthumb { aspect-ratio: 9/16; border-radius: 12px; overflow: hidden; background: var(--skeleton); }
.sthumb img { width: 100%; height: 100%; object-fit: cover; }
.stitle { font-size: 14px; font-weight: 500; margin-top: 8px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.sviews { font-size: 12px; color: var(--text-2); }

/* skeletons */
.sk { border-radius: 12px; background: linear-gradient(100deg, var(--skeleton) 45%, var(--hover) 50%, var(--skeleton) 55%); background-size: 200% 100%; animation: shimmer 1.2s infinite; }
@keyframes shimmer { to { background-position: -200% 0; } }
.sk-thumb { aspect-ratio: 16/9; }
.sk-line { height: 14px; margin-top: 10px; border-radius: 4px; }
.sk-line.w60 { width: 60%; }
.sk-ava { width: 36px; height: 36px; border-radius: 50%; flex: none; }
.sk-row { display: flex; gap: 12px; }
