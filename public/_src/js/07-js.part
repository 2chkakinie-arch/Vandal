/* ================================================================= MY PAGE */
function renderMyPage() {
  setActiveNav('you');
  const hist = History.list();
  const likes = Likes.list();
  const saves = Saves.list();
  const subs = Subs.list();
  if (!hist.length && !likes.length && !saves.length && !subs.length) {
    app.innerHTML = nudgeHtml('まずは検索してみましょう', '視聴履歴・高く評価した動画・保存した動画がここに表示されます。');
    return;
  }
  app.innerHTML = `
    <div class="mypage">
      <h1 class="mp-title">マイページ</h1>
      ${subs.length ? `
        <div class="mp-sec-h">登録チャンネル</div>
        <div class="subs-avatars">
          ${subs.map(s => `<a class="subs-av" href="#/channel/${esc(s.id)}">${s.avatar ? `<img src="${esc(s.avatar)}" alt="">` : '<div class="sk" style="width:100%;height:100%;border-radius:50%"></div>'}<span>${esc(s.name || '')}</span></a>`).join('')}
        </div>` : ''}
      <div class="mp-sec-h">履歴 ${hist.length ? `<button class="mp-clear" id="hist-clear">履歴をすべて削除</button>` : ''}</div>
      ${hist.length ? `<div class="grid">${hist.slice(0, 12).map(h => storedCard(h, { onRemove: true })).join('')}</div>`
        : '<p class="mp-empty">履歴はまだありません。</p>'}
      <div class="mp-sec-h">高く評価した動画</div>
      ${likes.length ? `<div class="grid">${likes.slice(0, 12).map(h => storedCard(h)).join('')}</div>`
        : '<p class="mp-empty">高く評価した動画はまだありません。</p>'}
      <div class="mp-sec-h">保存した動画</div>
      ${saves.length ? `<div class="grid">${saves.slice(0, 12).map(h => storedCard(h)).join('')}</div>`
        : '<p class="mp-empty">保存した動画はまだありません。</p>'}
    </div>`;
  $('#hist-clear')?.addEventListener('click', () => {
    History.clear();
    toast('履歴を削除しました');
    renderMyPage();
  });
}

/* ========================================================== SUBSCRIPTIONS */
function renderSubscriptions() {
  setActiveNav('subs');
  const subs = Subs.list();
  if (!subs.length) {
    app.innerHTML = nudgeHtml(
      '最新の動画をチェック',
      'チャンネルを登録すると、そのチャンネルの最新動画がここに表示されます。まずは検索してチャンネルを登録しましょう。',
      '<svg viewBox="0 0 24 24"><path d="M4 5h16v2H4zm0 4h16v2H4zm0 4h16v2H4zm0 4h10v2H4z"/></svg>'
    );
    return;
  }
  app.innerHTML = `
    <div class="mypage">
      <h1 class="mp-title">最新動画</h1>
      <div class="subs-avatars">
        ${subs.map(s => `<a class="subs-av" href="#/channel/${esc(s.id)}">${s.avatar ? `<img src="${esc(s.avatar)}" alt="">` : '<div class="sk" style="width:100%;height:100%;border-radius:50%"></div>'}<span>${esc(s.name || '')}</span></a>`).join('')}
      </div>
      <div id="subs-feed"><div class="mini-spin"></div></div>
    </div>`;
  const feed = $('#subs-feed');
  const channels = subs.slice(0, 4);
  channels.forEach((s) => {
    api('/api/channel/' + encodeURIComponent(s.id), { ttl: 8 * 60e3 })
      .then(d => {
        if (!document.body.contains(feed)) return;
        feed.querySelector('.mini-spin')?.remove();
        const vids = (d.items || []).filter(i => i.kind === 'video').slice(0, 8);
        const shorts = (d.items || []).filter(i => i.kind === 'short').slice(0, 8);
        const sec = document.createElement('div');
        sec.innerHTML =
          `<div class="mp-sec-h" style="padding-left:0">${esc(d.name || s.name || '')}</div>` +
          (vids.length ? `<div class="grid">${vids.map(v => videoCard(v)).join('')}</div>` : '') +
          (shorts.length ? shortsShelf(shorts) : '') +
          (!vids.length && !shorts.length ? '<p class="mp-empty">動画が見つかりませんでした。</p>' : '');
        feed.appendChild(sec);
      })
      .catch(() => {
        if (!document.body.contains(feed)) return;
        feed.querySelector('.mini-spin')?.remove();
      });
  });
}

/* ========================================================== SETTINGS (一般) */
function renderSettings() {
  setActiveNav('settings');

  app.innerHTML = `
  <div class="set-page">
    <div class="set-head">
      <img src="/logo.svg" alt="" class="set-logo">
      <div>
        <h1>設定</h1>
        <p class="set-sub">外観とデータの一般的な設定</p>
      </div>
    </div>

    <section class="set-card">
      <h2><span class="set-ic">🎨</span>外観</h2>
      <div class="set-actions">
        <div class="seg seg-sm" id="cfg-theme" style="max-width:340px">
          <button data-v="light">ライト</button>
          <button data-v="dark">ダーク</button>
        </div>
      </div>
    </section>

    <section class="set-card">
      <h2><span class="set-ic">🌐</span>インスタンス協力メッシュ</h2>
      <p class="set-note">デプロイされた Vandal は設定不要で自動的にメッシュへ参加し、生きているプロキシと健全性を共有します。プライベートモードでは自 URL を一切共有せず匿名で参加します（内部の共同作業は継続）。参加状況は <a href="#/instances">インスタンス</a> ページで確認できます。</p>
      <div class="set-actions" style="flex-direction:column;align-items:flex-start;gap:14px">
        <div>
          <div class="set-note" style="margin:0 0 6px"><b>参加モード</b></div>
          <div class="seg seg-sm" id="cfg-mesh-mode" style="max-width:420px">
            <button data-v="public">共同参加（既定）</button>
            <button data-v="private">プライベート</button>
          </div>
        </div>
        <div>
          <div class="set-note" style="margin:0 0 6px"><b>メッシュ参加</b>（無効で完全単独運用）</div>
          <div class="seg seg-sm" id="cfg-mesh-enabled" style="max-width:420px">
            <button data-v="on">参加する</button>
            <button data-v="off">無効にする</button>
          </div>
        </div>
        <div class="set-note" id="mesh-live-status">メッシュ状態を取得中…</div>
      </div>
    </section>

    <section class="set-card">
      <h2><span class="set-ic">🧹</span>データ管理</h2>
      <div class="set-actions">
        <button class="set-btn" id="s-clear-history">履歴を全消去</button>
        <button class="set-btn" id="s-clear-cache">セッションキャッシュを消去</button>
        <button class="set-btn warn" id="s-clear-all">すべてのローカルデータを消去</button>
      </div>
      <p class="set-note">履歴・高評価・保存・登録チャンネルは、この端末のブラウザ内にのみ保存されます。</p>
    </section>

    <section class="set-card">
      <h2><span class="set-ic">ℹ️</span>Vandal について</h2>
      <p class="set-about">Vandal — 最速の動画体験を目指す、完全に独立したオープンプロジェクト。インスタンス協力メッシュで、起動中の各サイトの URL と生きているプロキシをサーバー側で自動集計・共有します。</p>
      <div class="set-actions">
        <a class="set-btn" href="#/doc">詳細・ドキュメントを見る</a>
      </div>
    </section>
  </div>`;

  const seg = $('#cfg-theme');
  const syncSeg = () => seg.querySelectorAll('button').forEach((b) =>
    b.classList.toggle('sel', (b.dataset.v === 'dark') === document.documentElement.classList.contains('dark')));
  syncSeg();
  seg.addEventListener('click', (e) => {
    const b = e.target.closest('button[data-v]');
    if (!b) return;
    applyTheme(b.dataset.v === 'dark');
    syncSeg();
  });

  /* ---- mesh settings（settings.json 相当。data/config.json に永続化される） ---- */
  const meshModeSeg = $('#cfg-mesh-mode');
  const meshEnabledSeg = $('#cfg-mesh-enabled');
  let meshCfg = null;
  const syncMeshSegs = () => {
    if (!meshCfg) return;
    meshModeSeg.querySelectorAll('button').forEach((b) => b.classList.toggle('sel', (b.dataset.v === 'private') === !!meshCfg.meshPrivate));
    meshEnabledSeg.querySelectorAll('button').forEach((b) => b.classList.toggle('sel', (b.dataset.v === 'on') === !!meshCfg.meshEnabled));
  };
  api('/api/settings', { ttl: 5 * 1000 }).then((c) => {
    meshCfg = c;
    syncMeshSegs();
    const st = c.mesh || {};
    $('#mesh-live-status').innerHTML = `ピア <b>${st.aliveCount ?? 0}</b> 台が起動中（健全 ${st.healthyPeers ?? 0}）・共有プロキシ <b>${st.shareProxies ?? 0}</b> 本・モード <b>${st.mode === 'private' ? 'プライベート' : '共同参加'}</b>${st.self?.url ? ` ・自 URL <code>${esc(st.self.url)}</code>` : ''}`;
  }).catch(() => { $('#mesh-live-status').textContent = 'メッシュ状態を取得できませんでした。'; });
  meshModeSeg.addEventListener('click', async (e) => {
    const b = e.target.closest('button[data-v]');
    if (!b || !meshCfg) return;
    try {
      meshCfg = await api('/api/settings', { method: 'POST', body: JSON.stringify({ meshPrivate: b.dataset.v === 'private' }), ttl: 0 });
      syncMeshSegs();
      toast(b.dataset.v === 'private' ? 'プライベートインスタンスに切り替えました' : '共同参加モードに切り替えました');
    } catch (_) { toast('変更に失敗しました'); }
  });
  meshEnabledSeg.addEventListener('click', async (e) => {
    const b = e.target.closest('button[data-v]');
    if (!b || !meshCfg) return;
    try {
      meshCfg = await api('/api/settings', { method: 'POST', body: JSON.stringify({ meshEnabled: b.dataset.v === 'on' }), ttl: 0 });
      syncMeshSegs();
      toast(b.dataset.v === 'on' ? 'メッシュに参加しました' : 'メッシュを無効化しました（単独運用）');
    } catch (_) { toast('変更に失敗しました'); }
  });

  $('#s-clear-history').addEventListener('click', () => { History.clear(); toast('履歴を消去しました'); });
  $('#s-clear-cache').addEventListener('click', () => {
    try {
      Object.keys(sessionStorage).filter(k => k.startsWith('vandal:sc:')).forEach(k => sessionStorage.removeItem(k));
      Object.keys(localStorage).filter(k => k.startsWith('vandal:snap:')).forEach(k => localStorage.removeItem(k));
      toast('キャッシュを消去しました');
    } catch (_) { toast('消去に失敗しました'); }
  });
  $('#s-clear-all').addEventListener('click', () => {
    try {
      Object.keys(localStorage).filter(k => k.startsWith('vandal')).forEach(k => localStorage.removeItem(k));
      Object.keys(sessionStorage).filter(k => k.startsWith('vandal')).forEach(k => sessionStorage.removeItem(k));
      toast('すべてのローカルデータを消去しました');
      renderSettings();
    } catch (_) { toast('消去に失敗しました'); }
  });

  return { destroy() {} };
}

/* ========================================================== DOC (ドキュメント) */
function renderDoc() {
  setActiveNav('doc');

  app.innerHTML = `
  <div class="doc-page">
    <div class="doc-hero">
      <img src="/logo.svg" alt="Vandal" class="doc-logo">
      <p class="doc-tag">最速の、自己完結型の動画体験。</p>
    </div>

    <div class="doc-grid">
      <section class="doc-card">
        <h2>🚀 Vandal とは</h2>
        <p>Vandal は、動画を可能な限り高速に再生するための自己完結型フロントエンドです。InnerTube 直結エンジン、認定プロキシによるダイレクト再生、そしてインスタンス協力メッシュを備えています。</p>
      </section>

      <section class="doc-card">
        <h2>🌐 インスタンス協力メッシュ（自動参加・設定不要）</h2>
        <p>デプロイされた瞬間から、その URL は自動で「Vandal インスタンスリスト」に追加され、起動中のインスタンス同士が WebSocket（<code>/.vandal-mesh</code>）で相互接続。生きているプロキシと健全性（CPU・混み具合）を共有し、ティア（S/A/B/C）で自動選別した分業を行います: 上位ティアへのメタ取得の委譲、プロキシ収集のシャード分担、並列取得など。</p>
        <pre class="doc-code"># 何も設定しなくてOK。自 URL はデプロイ環境変数 or 最初の公開アクセスから自動検出。
# 明示したいときだけ（任意）:
VANDAL_MESH_URL=https://vandal.example.com          # 自インスタンスの公開 URL を固定
VANDAL_MESH_PEERS=https://peer1.example.com,...     # 最初の接続先（ゴシップで自動拡大）
# settings.json 相当（data/config.json / 設定ページからも変更可）:
#   "meshPrivate": true   → URL を共有しない匿名参加（内部の共同作業は継続）
#   "meshEnabled": false  → 完全単独運用に戻す</pre>
        <p class="doc-note">訪問者にはインスタンスの URL を省略表記でしか表示しません。混み具合・CPU・利用できるプロキシの数は <code>/health</code>（ダッシュボード）と <code>/api/health</code>（JSON）で確認でき、健全インスタンスが十分なときはさらに並列化して高速化します。</p>
      </section>

      <section class="doc-card">
        <h2>📡 デプロイ</h2>
        <p>Render / Railway / Docker / Cloudflare Workers / Vercel など、さまざまな環境へ展開できます。各デプロイボタンは README に掲載しています。</p>
      </section>

      <section class="doc-card doc-license">
        <h2>⚖️ ライセンスと利用条件（絶対遵守）</h2>
        <p>このプロジェクトをあなたの環境で自由に使用、デプロイ、または他者へ共有することを許可します。改変の禁止（絶対遵守）。</p>
        <p><strong>本プロジェクトのソースコードや設計思想を保持するため、コードの改変は一切禁止とします。元の形を尊重し、配布・公開を行うよう強くお願いします。このプロジェクトを絶対に他プロジェクトのAPIや内部技術として利用しないでください。</strong></p>
      </section>
    </div>
  </div>`;

  return { destroy() {} };
}

/* ======================================================= INSTANCES (インスタンス) */

const TIER_META = {
  S: { label: 'S', cls: 's', desc: '最速 — 発行も中継も引き受ける主力' },
  A: { label: 'A', cls: 'a', desc: '健全 — メタ取得の委譲先として優先起用' },
  B: { label: 'B', cls: 'b', desc: '平常 — プロキシ収集と中継を担当' },
  C: { label: 'C', cls: 'c', desc: '注意 — 負荷が高いか資源が不足（回復を待つ）' },
};

function instBar(pct) {
  const v = Math.max(0, Math.min(100, Math.round(pct)));
  return `<span class="inst-bar"><i style="width:${v}%"></i></span><span class="inst-bar-num">${v}</span>`;
}

function instChips(h, extra = []) {
  if (!h) return extra.join('');
  const chips = [
    `<span class="ichip">CPU <b>${Math.round(h.cpu || 0)}%</b></span>`,
    `<span class="ichip">lag <b>${Math.round(h.lag || 0)}ms</b></span>`,
    `<span class="ichip">mem <b>${Math.round(h.mem || 0)}%</b></span>`,
    `<span class="ichip">同時 <b>${h.active ?? 0}</b></span>`,
    `<span class="ichip">プロキシ <b>${h.proxies ?? 0}</b>${h.issuers ? ` <em>issuer ${h.issuers}</em>` : ''}</span>`,
    `<span class="ichip">稼働 <b>${fmtUptime(h.uptime || 0)}</b></span>`,
    ...extra,
  ];
  return chips.join('');
}

function fmtUptime(sec) {
  if (sec >= 86400) return Math.floor(sec / 86400) + '日';
  if (sec >= 3600) return Math.floor(sec / 3600) + '時間';
  if (sec >= 60) return Math.floor(sec / 60) + '分';
  return sec + '秒';
}

function instCard(p, { self = false } = {}) {
  const h = p.health || {};
  const score = h.score ?? 0;
  const tier = p.tier || 'C';
  const title = p.anonymous ? '匿名ピア（URL 非公開で参加中）' : (p.name || p.url || 'unknown instance');
  const urlLine = self
    ? (p.url ? `<div class="inst-url mono">${esc(p.url)}</div>` : `<div class="inst-url mono">URL 未確定（最初の公開アクセスで自動検出されます）</div>`)
    : (p.anonymous ? `<div class="inst-url">🔒 プライベート参加（URL 非公開）</div>` : `<div class="inst-url mono">${esc(p.url || '')}</div>`);
  return `
  <div class="inst-card ${self ? 'self' : ''}">
    <div class="inst-card-top">
      <span class="tier-badge t-${TIER_META[tier]?.cls || 'c'}" title="${esc(TIER_META[tier]?.desc || '')}">${tier}</span>
      <div class="inst-name">${esc(title)}${self ? '<span class="inst-self-tag">このインスタンス</span>' : ''}</div>
      <div class="inst-score">${instBar(score)}</div>
    </div>
    ${urlLine}
    <div class="inst-chips">${instChips(h, [
      p.ms != null ? `<span class="ichip">RTT <b>${p.ms}ms</b></span>` : '',
      p.alive ? '<span class="ichip ok">● alive</span>' : '<span class="ichip warn">◌ stale</span>',
      self ? `<span class="ichip">${'スコア'} <b>${score}</b></span>` : '',
    ])}</div>
  </div>`;
}

function renderInstances() {
  setActiveNav('instances');

  app.innerHTML = `
  <div class="inst-page">
    <div class="set-head">
      <div class="inst-hero-ic">
        <svg viewBox="0 0 24 24" class="ic"><path d="M12 2a3 3 0 0 1 3 3c0 1-.5 1.9-1.2 2.4l.2.1c2.9 1 5 3.5 5.8 6.6l.9-.4A3 3 0 1 1 22 17.5l-1.5 3.3a1 1 0 0 1-1.3.5l-2-1a1 1 0 0 1-.5-1.3l.9-2A9 9 0 0 0 6.4 17l.9 2a1 1 0 0 1-.5 1.3l-2 1a1 1 0 0 1-1.3-.5L2 17.5A3 3 0 1 1 3.3 13.7l.9.4C5 11 7.1 8.5 10 7.5l.2-.1A3 3 0 0 1 12 2z"/></svg>
      </div>
      <div>
        <h1>インスタンス</h1>
        <p class="set-sub">Vandal インスタンス協力メッシュ — 起動中の全インスタンスが自動でここに集まり、健全性（ティア）で選別されながら分業します</p>
      </div>
    </div>
    <div id="inst-body"><div class="mini-spin"></div></div>
  </div>`;

  let timer = null;
  let alive = true;

  async function refresh() {
    let st = null, cfg = null;
    try { st = await api('/api/mesh/state', { ttl: 9 * 1000 }); } catch (_) {}
    try { cfg = await api('/api/settings', { ttl: 9 * 1000 }); } catch (_) {}
    if (!alive || !$('#inst-body')) return;
    const body = $('#inst-body');
    if (!st) { body.innerHTML = nudgeHtml('状態を取得できませんでした', 'サーバーが混み合っています。少し待ってから再試行してください。'); return; }

    const self = st.self || {};
    const peers = st.peers || [];
    const tiers = { S: [], A: [], B: [], C: [] };
    for (const p of peers) (tiers[p.tier] || tiers.C).push(p);
    // 自分もティア表の先頭に載せる
    const selfEntry = {
      url: self.url, name: self.name || 'vandal', anonymous: false,
      health: self.health, tier: self.health?.tier || 'C', ms: 0, alive: true, __self: true,
    };
    tiers[selfEntry.tier].unshift(selfEntry);

    const tierRows = ['S', 'A', 'B', 'C'].map((t) => {
      const list = tiers[t];
      if (!list.length) return '';
      return `
      <div class="tier-row">
        <div class="tier-cell">
          <span class="tier-badge big t-${TIER_META[t].cls}">${t}</span>
          <span class="tier-desc">${esc(TIER_META[t].desc)}</span>
        </div>
        <div class="tier-cards">${list.map((p) => instCard(p, { self: !!p.__self })).join('')}</div>
      </div>`;
    }).join('');

    const mode = st.mode === 'private';
    const roles = st.delegate?.roles || {};
    const shard = roles.scanShard || {};

    body.innerHTML = `
      <div class="inst-self-strip ${selfEntry.tier}">
        <div class="iss-left">
          <span class="tier-badge big t-${TIER_META[selfEntry.tier]?.cls}">${selfEntry.tier}</span>
          <div>
            <div class="iss-name">このインスタンス <b class="mono">${esc(self.url || 'URL 未確定')}</b></div>
            <div class="iss-sub">score <b>${selfEntry.health?.score ?? '—'}</b>/100 ・ピア <b>${st.aliveCount - 1 >= 0 ? st.aliveCount - 1 : peers.length}</b> 台と協力中 ・共有プロキシ <b>${st.shareProxies}</b> 本</div>
          </div>
        </div>
        <div class="iss-right">
          <span class="mode-pill ${mode ? 'priv' : 'pub'}">${mode ? '🔒 プライベート' : '🌐 共同参加'}</span>
          <button class="set-btn" id="inst-mode-toggle">${mode ? '公開参加にする' : 'プライベートにする'}</button>
        </div>
      </div>

      <div class="tier-table">${tierRows || '<div class="inst-empty">ピアはまだいません。他の Vandal インスタンスがこのURLの <code>/.vandal-mesh</code> に接続すると自動で参加します。</div>'}</div>

      <div class="inst-grid">
        <section class="set-card">
          <h2><span class="set-ic">🧠</span>自動分業（スマート共同作業）</h2>
          <ul class="inst-roles">
            <li><b>メタ取得の委譲</b> — 自インスタンスの発行基盤が弱いとき、S/A ティアの健全インスタンスへ動画情報の取得を並行委譲します（現在の委譲先: <b>${(roles.metaPeers || []).length}</b> 台）。</li>
            <li><b>プロキシ収集の分担</b> — 候補リストをシャード分割し、各インスタンスが別担当区間を実測。見つかった生きているプロキシは全員で共有します（担当シャード: <b>${shard.index ?? '—'}/${shard.count ?? '—'}</b>）。</li>
            <li><b>並列ヘッジ</b> — 健全インスタンスが十分にいるほど、動画発行とコメント取得の当たり筋が増え、初速が伸びます（健全ピア: <b>${st.healthyPeers ?? 0}</b> 台）。</li>
          </ul>
        </section>
        <section class="set-card">
          <h2><span class="set-ic">🔒</span>プライバシー</h2>
          <p class="set-note">訪問者には各インスタンスの URL を省略表記でしか見せません（共同作業の内部では完全な URL を使用）。さらに設定（settings.json 相当: <code>meshPrivate</code>）で URL を一切共有しない「プライベートインスタンス」にできます。その場合も内部の共同作業には参加し続けます。</p>
          <div class="set-actions">
            <a class="set-btn" href="#/settings">設定を開く</a>
            <a class="set-btn" href="/health" target="_blank" rel="noopener">/health ダッシュボード</a>
          </div>
        </section>
      </div>`;

    $('#inst-mode-toggle')?.addEventListener('click', async () => {
      const next = !(st.mode === 'private');
      try {
        await api('/api/settings', { method: 'POST', body: JSON.stringify({ meshPrivate: next }), ttl: 0 });
        toast(next ? 'プライベートインスタンスに切り替えました' : '公開参加モードに切り替えました');
        refresh();
      } catch (_) { toast('変更に失敗しました'); }
    });
  }

  refresh();
  timer = setInterval(refresh, 10 * 1000);
  return { destroy() { alive = false; clearInterval(timer); } };
}
